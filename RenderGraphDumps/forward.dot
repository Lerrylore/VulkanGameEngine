digraph RenderGraph {
  rankdir=LR;
  newrank=true;
  compound=true;
  splines=polyline;
  bgcolor="#10161f";
  graph [fontname="Segoe UI", fontsize=18, fontcolor="#e8eef7", label="Render Graph\nresource flow + execution dependencies", labelloc=t, labeljust=l, pad=0.25, nodesep=0.55, ranksep=0.9];
  node [fontname="Segoe UI", fontsize=10, color="#718096", fontcolor="#17202b"];
  edge [fontname="Segoe UI", fontsize=9, color="#cbd5e1", fontcolor="#e8eef7", arrowsize=0.7];

  subgraph cluster_passes {
    label="PASS ORDER / TOPOLOGICAL EXECUTION";
    color="#405168";
    fontcolor="#b9c7d8";
    fontname="Segoe UI";
    fontsize=11;
    style="rounded,dashed";
    p0 [shape=box, style="rounded,filled", fillcolor="#b7d7c0", color="#5c9b6f", penwidth=1.4, group="passes", label="[0] ShadowPass\nGraphics", tooltip="pass 0: ShadowPass"];
    p1 [shape=box, style="rounded,filled", fillcolor="#b7d7c0", color="#5c9b6f", penwidth=1.4, group="passes", label="[1] ForwardOpaquePass\nGraphics", tooltip="pass 1: ForwardOpaquePass"];
    p2 [shape=box, style="rounded,filled", fillcolor="#b7d7c0", color="#5c9b6f", penwidth=1.4, group="passes", label="[2] ParticleOverlayPass\nGraphics", tooltip="pass 2: ParticleOverlayPass"];
  }

  subgraph cluster_resources {
    label="IMAGES / LIFETIMES";
    color="#665d3d";
    fontcolor="#d9c98f";
    fontname="Segoe UI";
    fontsize=11;
    style="rounded,dashed";
    r0 [shape=box, style="rounded,filled", fillcolor="#fff0bd", color="#c5a94b", penwidth=1.3, group="resources", label="ShadowMap\nD32Sfloat | 2048x2048 | samples=1\nimported | lifetime 0..1 / uses 2", tooltip="image 0: ShadowMap"];
    r1 [shape=box, style="rounded,filled", fillcolor="#fff0bd", color="#c5a94b", penwidth=1.3, group="resources", label="ForwardColorMSAA\nR8G8B8A8Unorm | 800x600 | samples=8\nimported | lifetime 1..1 / uses 1", tooltip="image 1: ForwardColorMSAA"];
    r2 [shape=box, style="rounded,filled", fillcolor="#fff0bd", color="#c5a94b", penwidth=1.3, group="resources", label="ForwardDepthMSAA\nD32Sfloat | 800x600 | samples=8\nimported | lifetime 1..1 / uses 1", tooltip="image 2: ForwardDepthMSAA"];
    r3 [shape=box, style="rounded,filled", fillcolor="#fff0bd", color="#c5a94b", penwidth=1.3, group="resources", label="Swapchain\nR8G8B8A8Unorm | 800x600 | samples=1\nimported | lifetime 1..2 / uses 2", tooltip="image 3: Swapchain"];
  }

  p0 -> r0 [color="#f0aa55", fontcolor="#e8eef7", penwidth=1.6, label="Write / DepthAttachment"];
  r0 -> p1 [color="#55b9e6", fontcolor="#e8eef7", penwidth=1.6, label="Read / Sampled"];
  p1 -> r1 [color="#f0aa55", fontcolor="#e8eef7", penwidth=1.6, label="Write / ColorAttachment"];
  p1 -> r2 [color="#f0aa55", fontcolor="#e8eef7", penwidth=1.6, label="Write / DepthAttachment"];
  p1 -> r3 [color="#f0aa55", fontcolor="#e8eef7", penwidth=1.6, label="Write / ColorAttachment"];
  p2 -> r3 [color="#c58ad9", fontcolor="#e8eef7", penwidth=1.6, label="ReadWrite / ColorAttachment"];
  r3 -> p2 [color="#c58ad9", fontcolor="#e8eef7", penwidth=1.6, label="ReadWrite / ColorAttachment"];
  p0 -> p1 [style=dashed, color="#9aa8bb", fontcolor="#cbd5e1", penwidth=1.4, constraint=false, label="via ShadowMap"];
  p1 -> p2 [style=dashed, color="#9aa8bb", fontcolor="#cbd5e1", penwidth=1.4, constraint=false, label="via Swapchain"];

  legend [shape=note, style="filled", fillcolor="#202b3a", color="#53657c", fontcolor="#e8eef7", label="LEGEND\nsolid arrow = resource use\ndashed arrow = execution dependency\nblue = read   orange = write   purple = read/write"];
}
